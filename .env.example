# Agentic AI Harness Configuration Example
# Copy this file to .env and update values.

# LLM
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=your_model_name_here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Database
DATABASE_URL=your_database_connection_string_here
# "memory" or "pgvector"
VECTOR_STORE=memory

# Server
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
DEBUG=false

# Security
# Set to enable Bearer token authentication
API_KEY=

# Comma-separated origins in production
CORS_ORIGINS=["*"]

# Rate limiting
RATE_LIMIT_REQUESTS=10.0
RATE_LIMIT_BURST=20.0

# Monitoring
# Optional
SENTRY_DSN=

# Enable production log aggregation
JSON_LOGGING=false

# Cache
LLM_CACHE_SIZE=500
LLM_CACHE_TTL=3600